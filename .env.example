# Copy this to .env and fill in your values
# Never commit .env — it contains secrets

# LLM (required)
ANTHROPIC_API_KEY=sk-ant-...

# Embeddings — OpenAI text-embedding-3-small (required)
OPENAI_API_KEY=sk-proj-...

# Optional legacy key (not used in current code)
# VOYAGE_API_KEY=pa-...

# Set automatically in docker-compose — override for Railway
# QDRANT_URL=http://qdrant:6333
# SQLITE_PATH=/data/history.db
# EMBED_MODEL=text-embedding-3-small

# Frontend build — set to your Railway backend public URL in production
# VITE_API_URL=https://your-backend.railway.app
